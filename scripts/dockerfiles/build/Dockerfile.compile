# Fluent Bit compilation stage
# This Dockerfile handles the compilation of Fluent Bit from source
# It expects a build environment with source code prepared

ARG AL_TAG
FROM amazon/aws-for-fluent-bit:build-common-al${AL_TAG}

# Ensure we're in the build directory
WORKDIR /tmp/fluent-bit/build/

# Build Fluent Bit with release compiler flags
# These flags are optimized for production use
RUN cmake -DFLB_RELEASE=On \
          -DFLB_TRACE=Off \
          -DFLB_JEMALLOC=On \
          -DFLB_TLS=On \
          -DFLB_SHARED_LIB=Off \
          -DFLB_EXAMPLES=Off \
          -DFLB_HTTP_SERVER=On \
          -DFLB_IN_SYSTEMD=On \
          -DFLB_OUT_KAFKA=On \
          -DFLB_ARROW=On ..

# Compile using all available processors for faster builds
RUN make -j $(getconf _NPROCESSORS_ONLN)

# Install the compiled binary to the expected location
RUN install bin/fluent-bit /fluent-bit/bin/
