# Amazon Linux 2023 Build Dependencies
# This Dockerfile installs all build dependencies required for compiling Fluent Bit on AL2023

# Amazon Linux Tag to use for images
ARG AL_TAG=2023
FROM public.ecr.aws/amazonlinux/amazonlinux:${AL_TAG}

# Install AL2023-specific build dependencies using dnf
RUN dnf upgrade -y && \
    dnf install -y  \
      glibc-devel \
      libyaml-devel \
      cmake \
      gcc \
      gcc-c++ \
      make \
      wget \
      unzip \
      tar \
      git \
      openssl-devel \
      cyrus-sasl-devel \
      pkgconf-pkg-config \
      systemd-devel \
      zlib-devel \
      valgrind-devel \
      ca-certificates \
      flex \
      bison
